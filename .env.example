# AWS SES OTP delivery
AWS_SES_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@kankanasilks.com
SES_CONFIGURATION_SET=
# Generate each secret independently with at least 32 random bytes
OTP_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
ACCESS_TOKEN_TTL=1h
TRUST_PROXY=1
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
EMAIL_DOMAIN_BLOCKLIST=
EMAIL_DOMAIN_ALLOWLIST=
OTP_CAPTCHA_ENABLED=false
OTP_GLOBAL_PER_MINUTE=100
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@kankanasilks.com
COD_NEW_ACCOUNT_HOURS=24
COD_NEW_ACCOUNT_MAX_AMOUNT=2000
COD_PHONE_MAX_ORDERS_24H=2
COD_ADDRESS_MAX_ORDERS_24H=2
