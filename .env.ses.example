# Select nodemailer on QA and SES on production.
# QA: EMAIL_PROVIDER=nodemailer (set SMTP_* values on the QA server)
# Production: EMAIL_PROVIDER=ses
EMAIL_PROVIDER=ses

# Amazon SES email transport (Mumbai)
AWS_SES_REGION=ap-south-1

# Default sender for notifications/order emails (must belong to a verified SES identity)
SES_FROM_EMAIL=notifications@kankanasilks.com
SES_NOTIFICATIONS_FROM=notifications@kankanasilks.com
SES_NO_REPLY_FROM=no-reply@kankanasilks.com
SES_NEWSLETTER_FROM=newsletter@kankanasilks.com

# Customer reply destination and internal order/newsletter alerts
SES_REPLY_TO_EMAIL=support@kankanasilks.com
ADMIN_EMAIL=admin@kankanasilks.com

# Optional. Leave empty until the configuration set exists in SES.
SES_CONFIGURATION_SET=
